server {
    listen 80;
    server_name topbearing.ua www.topbearing.ua;
    return 301 https://topbearing.ua$request_uri;
}
server {
    listen 443 ssl http2;
    server_name topbearing.ua;
    ssl_certificate /etc/letsencrypt/live/topbearing.ua/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/topbearing.ua/privkey.pem;
    client_max_body_size 8m;
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
